@* HR account layout: replaces the Basic theme account layout for sign-in, two-step code and sign-out.
   Same look as the Flutter sign-in page (frontend/HR-Design-System.md): light/dark and Arabic/English. *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI.Bundling
@using System.Globalization
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Basic.Bundling
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Basic.Themes.Basic.Components.PageAlerts
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var here = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var other = isAr ? "en" : "ar";
    var switchUrl = Url.Content("~/Abp/Languages/Switch") + "?culture=" + other + "&uiCulture=" + other + "&returnUrl=" + Uri.EscapeDataString(here.ToString());
    string T(string ar, string en) => isAr ? ar : en;
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T("نظام إدارة الموارد البشرية", "HR Management System")</title>
    <script>
        // Theme before first paint: manual choice on this page > the app's choice (hr_theme in the return URL) > system.
        (function () {
            var t = null;
            try { t = localStorage.getItem('hr-theme'); } catch (e) { }
            if (!t) {
                var q = new URLSearchParams(location.search);
                var ru = q.get('ReturnUrl') || q.get('returnUrl') || '';
                var m = /[?&]hr_theme=(light|dark)/.exec(ru);
                if (m) t = m[1];
            }
            if (!t) t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" />
    <abp-style-bundle name="@BasicThemeBundles.Styles.Global" />
    <link rel="stylesheet" href="~/hr-account/hr-account.css" />
    @await RenderSectionAsync("styles", false)
</head>
<body class="hr-account">
    <div class="hr-bg"></div>
    <div class="hr-topbar">
        <a class="hr-lang" href="@switchUrl" id="HrLangSwitch" data-lang="@other">@(isAr ? "English" : "العربية")</a>
        <button type="button" class="hr-theme" id="HrThemeToggle"
                data-title-light="@T("فاتح", "Light")" data-title-dark="@T("داكن", "Dark")" aria-label="@T("المظهر", "Theme")">
            <svg class="hr-ico-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="hr-ico-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
    </div>
    <main class="hr-center">
        <div class="hr-card">
            <div class="hr-logo">
                <img class="hr-mark hr-mark-light" src="~/hr-account/hr_mark_light.png" alt="" />
                <img class="hr-mark hr-mark-dark" src="~/hr-account/hr_mark_dark.png" alt="" />
                <span class="hr-word">HR</span>
            </div>
            <div class="hr-alerts">@(await Component.InvokeAsync<PageAlertsViewComponent>())</div>
            @RenderBody()
        </div>
    </main>
    <abp-script-bundle name="@BasicThemeBundles.Scripts.Global" />
    <script src="~/Abp/ApplicationConfigurationScript"></script>
    <script src="~/hr-account/hr-account.js"></script>
    @await RenderSectionAsync("scripts", false)
</body>
</html>
