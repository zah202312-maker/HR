@page
@* Replaces the framework sign-in page with the HR design. Same model and post (Action = Login);
   two-step accounts continue on LoginTotp (HrLoginModel). Self-registration and the forgotten-password
   link are not offered: accounts and resets come from HR. *@
@using System.Globalization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@model Volo.Abp.Account.Web.Pages.Account.LoginModel
@inject IThemeManager ThemeManager
@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => isAr ? ar : en;
}
<h1 class="hr-title">@T("نظام إدارة الموارد البشرية", "HR Management System")</h1>
<p class="hr-subtitle">@T("سجّل دخولك للمتابعة.", "Sign in to continue.")</p>

@if (Model.EnableLocalLogin)
{
    <form method="post" class="hr-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ReturnUrlHash" />
        <div asp-validation-summary="ModelOnly" class="hr-error"></div>

        <label class="hr-label" for="LoginInput_UserNameOrEmailAddress">@T("اسم المستخدم أو البريد الإلكتروني", "Username or email")</label>
        <input asp-for="LoginInput.UserNameOrEmailAddress" class="hr-input" autocomplete="username" autofocus dir="ltr" />
        <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="hr-field-error"></span>

        <label class="hr-label" for="LoginInput_Password">@T("كلمة المرور", "Password")</label>
        <div class="hr-password">
            <input asp-for="LoginInput.Password" class="hr-input" autocomplete="current-password" dir="ltr" />
            <button type="button" class="hr-eye" data-target="LoginInput_Password" aria-label="@T("إظهار كلمة المرور", "Show password")">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </button>
        </div>
        <span asp-validation-for="LoginInput.Password" class="hr-field-error"></span>

        <label class="hr-check">
            <input asp-for="LoginInput.RememberMe" type="checkbox" />
            <span>@T("تذكرني", "Remember me")</span>
        </label>

        <button type="submit" class="hr-btn" name="Action" value="Login">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>@T("تسجيل الدخول", "Sign in")</span>
        </button>
        @if (Model.ShowCancelButton)
        {
            <button type="submit" class="hr-btn-text" name="Action" value="Cancel" formnovalidate>@T("إلغاء", "Cancel")</button>
        }
    </form>
    <p class="hr-hint">@T("نسيت كلمة السر؟ تواصل مع الموارد البشرية لإعادة تعيينها.", "Forgot your password? Ask HR to reset it.")</p>
}
else
{
    <div class="hr-error">@T("تسجيل الدخول المحلي غير مفعّل.", "Local sign-in is disabled.")</div>
}
